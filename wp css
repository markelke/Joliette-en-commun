/* ==========================================================================
   JOLIETTE EN COMMUN — Feuille de style personnalisée (corrigée)
   --------------------------------------------------------------------------
   Palette :
     Crème (fond) .......... #faf6f0
     Vert forêt (en-tête) .. #2d5a3d
     Vert foncé (survol) ... #1e3d2a
     Sauge (slogan/lignes) . #c8dfc8

   Corrections appliquées :
     - Fond crème restauré comme source UNIQUE (plus d'override vert foncé
       #1e3d2a sur le <body> — c'était la cause du fond sombre non désiré).
     - Règles de fond redondantes regroupées en un seul bloc.
     - Une seule "timeline" (verticale) — plus de conflit entre les deux versions.
     - Commentaire cassé "//*" corrigé en "/*".
   ========================================================================== */


/* ==========================================================================
   1. EN-TÊTE — VERT FORÊT
   ========================================================================== */
.site-header,
header#masthead,
.inside-header,
.inside-header.grid-container,
div.inside-header.grid-container {
  background-color: #2d5a3d !important;
  border: none !important;
  box-shadow: none !important;
  padding-top: max(20px, env(safe-area-inset-top)) !important;
  padding-bottom: 20px !important;
  margin-bottom: 0 !important;
}

.inside-header {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: center !important;
  padding-left: 40px !important;
  padding-right: 40px !important;
  width: 100% !important;
  max-width: 100% !important;
}

.site-branding-container {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 16px !important;
}

.site-branding {
  display: flex !important;
  flex-direction: column !important;
  align-items: flex-start !important;
}

img.header-image.is-logo-image {
  width: 72px !important;
  height: 72px !important;
  border-radius: 50% !important;
  object-fit: cover !important;
  flex-shrink: 0 !important;
}

/* Titre du site */
p.main-title a {
  font-family: 'Nunito', sans-serif !important;
  font-size: 2rem !important;
  font-weight: 800 !important;
  color: #ffffff !important;
  text-transform: uppercase !important;
  letter-spacing: 0.02em !important;
  line-height: 1.1 !important;
  display: block !important;
}

/* Slogan */
p.site-description {
  font-family: 'Nunito', sans-serif !important;
  font-size: 0.9rem !important;
  color: #c8dfc8 !important;
  font-weight: 500 !important;
  text-transform: none !important;
  letter-spacing: 0 !important;
  margin-top: 4px !important;
  display: block !important;
}


/* ==========================================================================
   2. FOND CRÈME GLOBAL — source unique de la couleur de fond
   ========================================================================== */
html, body,
.site-content, .grid-container, .entry-content, .entry-content > *,
.inside-article, .inside-article > *, #primary, .site-main,
.wp-block-columns, .wp-block-column, .gb-element-7c28e4a4 {
  background-color: #faf6f0 !important;
}

/* Espacements verticaux : pas de marge en haut */
.grid-container, #primary, .site-main,
.wp-block-columns, .wp-block-column, .gb-element-7c28e4a4 {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

/* Respiration crème entre l'en-tête et le contenu */
.site-content, .inside-article, .entry-content {
  margin-top: 0 !important;
  padding-top: 30px !important;
}


/* ==========================================================================
   3. MISE EN PAGE — COLONNES DE HAUTEUR ÉGALE (forum + sondage)
   ========================================================================== */
.wp-block-columns {
  display: flex !important;
  align-items: stretch !important;
}
.wp-block-column {
  display: flex !important;
  flex-direction: column !important;
}
#wpforo-wrap, .forminator-poll {
  flex: 1 !important;
  height: 100% !important;
  box-sizing: border-box !important;
}

/* Espace entre le bloc forum/sondage et les événements */
.gb-element-56de59ba {
  margin-top: 40px !important;
  padding-top: 20px !important;
}


/* ==========================================================================
   4. BOUTONS — CALENDRIER & RETOUR
   ========================================================================== */
a.gb-text-169aeb6e,
a.gb-text-d96ad459 {
  background-color: #2d5a3d !important;
  color: #faf6f0 !important;
  border-color: #2d5a3d !important;
}
a.gb-text-169aeb6e:hover,
a.gb-text-d96ad459:hover {
  background-color: #1e3d2a !important;
  border-color: #1e3d2a !important;
}

a.jc-retour-btn,
a.jc-retour-btn:hover {
  color: #faf6f0 !important;
}


/* ==========================================================================
   5. SONDAGE FORMINATOR
   ========================================================================== */
.forminator-poll {
  background: #ffffff !important;
  border-radius: 16px !important;
  padding: 26px !important;
  box-shadow: 0 4px 20px rgba(0,0,0,0.06) !important;
  border: 1px solid #eaeaea !important;
}
.forminator-poll .forminator-poll-title {
  font-size: 1.15rem !important;
  font-weight: 700 !important;
  color: #111827 !important;
  margin-bottom: 20px !important;
  line-height: 1.4 !important;
}
.forminator-poll .forminator-radio {
  background: #f9fafb !important;
  border: 1px solid #f3f4f6 !important;
  border-radius: 10px !important;
  padding: 12px 14px !important;
  margin-bottom: 10px !important;
}
.forminator-poll .forminator-radio:hover {
  background: #f3f4f6 !important;
  border-color: #e5e7eb !important;
}
.forminator-poll .forminator-button-submit {
  width: 100% !important;
  background: #2d5a3d !important;
  color: #ffffff !important;
  border: none !important;
  border-radius: 8px !important;
  padding: 14px !important;
  font-size: 1rem !important;
  font-weight: 600 !important;
  margin-top: 8px !important;
  cursor: pointer !important;
}
.forminator-poll .forminator-button-submit:hover {
  background: #1e3d2a !important;
}

/* Message « déjà voté » */
.forminator-poll .forminator-response-message {
  background-color: #e8f4ec !important;
  border: 1px solid #a8d4b4 !important;
  border-left: 4px solid #2d5a3d !important;
  border-radius: 10px !important;
  padding: 12px 16px !important;
}
.forminator-poll .forminator-label--forminator-error {
  font-size: 0 !important;
  color: transparent !important;
  display: block !important;
}
.forminator-poll .forminator-label--forminator-error::before {
  content: "Vous avez déjà enregistré votre vote. Merci !" !important;
  font-size: 0.95rem !important;
  color: #2d5a3d !important;
  font-weight: 500 !important;
  display: block !important;
}


/* ==========================================================================
   6. ÉLÉMENTS MASQUÉS
   ========================================================================== */
.header-widget-1, .header-widget-2 { display: none !important; }
.forminator-field-postdata,
.forminator-field-postdata .forminator-button-submit { display: none !important; }
.forminator-poll-edit-link,
.edit-link,
a[href*="action=edit"] { display: none !important; }
#menu-item-1885 { display: none !important; }  /* entrée de menu « Événements » */

/* Bannière PWA (mode application) */
@media all and (display-mode: standalone) {
  .hdsb-stickybanner { display: none !important; }
}

/* Titre de la page d'accueil */
.home .page-hero h1,
.home .entry-header h1,
.home .generate-page-header h1 { font-size: 1.8rem !important; }


/* ==========================================================================
  /* ==========================================================================
   📦 GRILLE D'ÉVÉNEMENTS — version améliorée
   ========================================================================== */

/* Grille : 1 colonne (mobile) par défaut */
.jc-events-grid-layout .jc-timeline {
  display: grid !important;
  grid-template-columns: 1fr !important;
  gap: 24px !important;
  list-style: none !important;
  padding: 0 !important;
  margin: 0 0 40px 0 !important;
}

/* Tablette : 2 colonnes (NOUVEAU — comble le trou mobile→ordi ; ajustable) */
@media (min-width: 640px) {
  .jc-events-grid-layout .jc-timeline {
    grid-template-columns: repeat(2, 1fr) !important;
  }
}

/* Ordinateur : 4 colonnes */
@media (min-width: 1024px) {
  .jc-events-grid-layout .jc-timeline {
    grid-template-columns: repeat(4, 1fr) !important;
  }
}

/* Tuiles d'événements */
.jc-events-grid-layout .jc-timeline-item {
  background-color: #fcfbf7 !important;
  border: 1px solid #e2ded2 !important;
  border-radius: 12px !important;
  padding: 20px !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: space-between !important;
  position: relative !important;
  box-shadow: 0 4px 6px rgba(0,0,0,0.04) !important;
}

/* Masquage des anciens points de la frise verticale */
.jc-events-grid-layout .jc-timeline-dot {
  display: none !important;
}

/* Date et heure (doré/bronze) */
.jc-events-grid-layout .jc-timeline-time {
  display: block !important;
  font-size: 0.85rem !important;
  font-weight: 700 !important;
  color: #c8963e !important;
  text-transform: uppercase !important;
  margin-bottom: 8px !important;
}

/* Titre (vert forêt) */
.jc-events-grid-layout .jc-timeline-title {
  font-size: 1.2rem !important;
  color: #1e3d2a !important;
  margin: 0 0 12px 0 !important;
  font-weight: 700 !important;
  line-height: 1.3 !important;
}

/* Affiche de l'activité */
.jc-events-grid-layout .jc-timeline-img {
  width: 100% !important;
  height: 160px !important;
  object-fit: cover !important;
  border-radius: 6px !important;
  margin-bottom: 12px !important;
}

/* ==========================================================================
   🔍 VOIR PLUS / VOIR MOINS  (avec accès clavier)
   ========================================================================== */

/* La case reste invisible MAIS focusable au clavier (accessibilité) */
.jc-events-grid-layout .jc-toggle-input {
  position: absolute !important;
  opacity: 0 !important;
  width: 1px !important;
  height: 1px !important;
  pointer-events: none !important;
}

.jc-events-grid-layout .jc-timeline-desc {
  display: -webkit-box !important;
  -webkit-line-clamp: 3;
  line-clamp: 3;                 /* version standard (NOUVEAU) */
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 0.95rem !important;
  color: #1e3d2a !important;
  line-height: 1.5 !important;
  margin: 0 0 6px 0 !important;
}

.jc-events-grid-layout .jc-toggle-input:checked + .jc-timeline-desc {
  -webkit-line-clamp: unset !important;
  line-clamp: unset !important;
  display: block !important;
  margin-bottom: 14px !important;
}

.jc-events-grid-layout .jc-toggle-label {
  display: inline-block !important;
  color: #2d5a3d !important;
  font-size: 0.85rem !important;
  font-weight: 700 !important;
  cursor: pointer !important;
  margin-bottom: 14px !important;
  user-select: none !important;
}

/* Contour visible quand on navigue au clavier (NOUVEAU) */
.jc-events-grid-layout .jc-toggle-input:focus-visible ~ .jc-toggle-label {
  outline: 2px solid #2d5a3d !important;
  outline-offset: 2px !important;
  border-radius: 3px !important;
}

.jc-events-grid-layout .jc-toggle-input:not(:checked) ~ .jc-toggle-label::before { content: "Voir plus ➔" !important; }
.jc-events-grid-layout .jc-toggle-input:checked ~ .jc-toggle-label::before { content: "Voir moins ↩" !important; }

/* Bouton Participer */
.jc-events-grid-layout .jc-timeline-btn {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
  background-color: #2d5a3d !important;
  color: #ffffff !important;
  text-decoration: none !important;
  padding: 10px 16px !important;
  border-radius: 6px !important;
  font-size: 0.9rem !important;
  font-weight: 600 !important;
  text-align: center !important;
  margin-top: auto !important;
  transition: background-color 0.2s ease !important;
}

.jc-events-grid-layout .jc-timeline-btn:hover {
  background-color: #1e3d2a !important;
}

/* Contour clavier sur le bouton (NOUVEAU) */
.jc-events-grid-layout .jc-timeline-btn:focus-visible {
  outline: 2px solid #1e3d2a !important;
  outline-offset: 2px !important;
}

/* ==========================================================================
   🏛️ FORUM + SONDAGE CÔTE À CÔTE
   ========================================================================== */

.jc-native-footer-row {
  display: flex !important;
  flex-direction: column !important;
  gap: 32px !important;
  margin-top: 50px !important;
  border-top: 1px solid #e2ded2 !important;
  padding-top: 40px !important;
}

@media (min-width: 1024px) {
  .jc-native-footer-row {
    flex-direction: row !important;
    align-items: flex-start !important;
  }
  /* flex: 1 1 + min-width:0 = ne déborde plus, et un contenu large
     (tableaux du forum) peut rétrécir au lieu de pousser la page */
  .jc-native-forum-col {
    flex: 1 1 62% !important;
    min-width: 0 !important;
  }
  .jc-native-poll-col {
    flex: 1 1 34% !important;
    min-width: 0 !important;
    background-color: #ffffff !important;
    padding: 24px !important;
    border: 1px solid #e2ded2 !important;
    border-radius: 12px !important;
    box-shadow: 0 4px 6px rgba(0,0,0,0.06) !important;
  }
}

/* ==========================================================================
   8. RÈGLES MOBILES (≤ 768 px)
   ========================================================================== */
@media (max-width: 768px) {
  /* Navigation principale masquée (hamburger géré par le thème) */
  .main-navigation { display: none !important; }

  /* En-tête empilé et centré */
  .inside-header {
    flex-direction: column !important;
    justify-content: center !important;
    padding: 16px !important;
  }
  .site-branding-container {
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
  }
  img.header-image.is-logo-image {
    margin-right: 0 !important;
    margin-bottom: 10px !important;
  }
  .site-branding { align-items: center !important; }
  p.site-description { text-align: center !important; }

  /* Masquer les résultats du sondage sur mobile */
  .forminator-poll .forminator-radio.forminator-disabled,
  .forminator-poll .forminator-poll-body,
  .forminator-poll .forminator-poll-footer {
    display: none !important;
  }
}
