/* ==========================================================================
   JOLIETTE EN COMMUN — Feuille de style personnalisée
   --------------------------------------------------------------------------
   Palette :
     Crème (fond) .......... #faf6f0
     Vert forêt (en-tête) .. #2d5a3d
     Vert foncé (survol) ... #1e3d2a
     Sauge (accents) ....... #c8dfc8
     Bronze (dates) ........ #c8963e
   ========================================================================== */


/* ==========================================================================
   1. EN-TÊTE — VERT FORÊT
   ========================================================================== */
.site-header,
header#masthead,
.inside-header,
.inside-header.grid-container,
div.inside-header.grid-container {
  background-color: #2d5a3d !important;
  border: none !important;
  box-shadow: none !important;
  padding-top: max(20px, env(safe-area-inset-top)) !important;
  padding-bottom: 20px !important;
  margin-bottom: 0 !important;
}

.inside-header {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  justify-content: center !important;
  padding-left: 40px !important;
  padding-right: 40px !important;
  width: 100% !important;
  max-width: 100% !important;
}

.site-branding-container {
  display: flex !important;
  flex-direction: row !important;
  align-items: center !important;
  gap: 16px !important;
}

.site-branding {
  display: flex !important;
  flex-direction: column !important;
  align-items: flex-start !important;
}

img.header-image.is-logo-image {
  width: 72px !important;
  height: 72px !important;
  border-radius: 50% !important;
  object-fit: cover !important;
  flex-shrink: 0 !important;
}

p.main-title a {
  font-family: 'Nunito', sans-serif !important;
  font-size: 2rem !important;
  font-weight: 800 !important;
  color: #ffffff !important;
  text-transform: uppercase !important;
  letter-spacing: 0.02em !important;
  line-height: 1.1 !important;
  display: block !important;
}

p.site-description {
  font-family: 'Nunito', sans-serif !important;
  font-size: 0.9rem !important;
  color: #c8dfc8 !important;
  font-weight: 500 !important;
  text-transform: none !important;
  letter-spacing: 0 !important;
  margin-top: 4px !important;
  display: block !important;
}


/* ==========================================================================
   2. FOND CRÈME GLOBAL
   ========================================================================== */
html, body,
.site-content, .grid-container, .entry-content, .entry-content > *,
.inside-article, .inside-article > *, #primary, .site-main,
.wp-block-columns, .wp-block-column, .gb-element-7c28e4a4 {
  background-color: #faf6f0 !important;
}

.grid-container, #primary, .site-main,
.wp-block-columns, .wp-block-column, .gb-element-7c28e4a4 {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

.site-content, .inside-article, .entry-content {
  margin-top: 0 !important;
  padding-top: 30px !important;
}


/* ==========================================================================
   3. MISE EN PAGE — COLONNES DE HAUTEUR ÉGALE (forum + sondage)
   ========================================================================== */
.wp-block-columns {
  display: flex !important;
  align-items: stretch !important;
}
.wp-block-column {
  display: flex !important;
  flex-direction: column !important;
}
#wpforo-wrap, .forminator-poll {
  flex: 1 !important;
  height: 100% !important;
  box-sizing: border-box !important;
}

.gb-element-56de59ba {
  margin-top: 40px !important;
  padding-top: 20px !important;
}


/* ==========================================================================
   4. BOUTONS — CALENDRIER & RETOUR
   ========================================================================== */
a.gb-text-169aeb6e,
a.gb-text-d96ad459 {
  background-color: #2d5a3d !important;
  color: #faf6f0 !important;
  border-color: #2d5a3d !important;
}
a.gb-text-169aeb6e:hover,
a.gb-text-d96ad459:hover {
  background-color: #1e3d2a !important;
  border-color: #1e3d2a !important;
}

.jc-events-header {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 12px !important;
  justify-content: center !important;
  margin-bottom: 24px !important;
}

a.gb-text-169aeb6e,
a.gb-text-d96ad459,
#jc-load-more-btn {
  background-color: #2d5a3d !important;
  color: #faf6f0 !important;
  border: none !important;
  border-radius: 6px !important;
  padding: 10px 18px !important;
  font-size: 0.9rem !important;
  font-weight: 600 !important;
  text-decoration: none !important;
  cursor: pointer !important;
  transition: background-color 0.2s ease !important;
}
a.gb-text-169aeb6e,
a.gb-text-d96ad459 { display: inline-block !important; }

a.gb-text-169aeb6e:hover,
a.gb-text-d96ad459:hover,
#jc-load-more-btn:hover {
  background-color: #1e3d2a !important;
  color: #faf6f0 !important;
}

#jc-load-more-btn { display: none !important; }

@media (max-width: 1023px) {
  .jc-events-grid-layout .jc-timeline .jc-timeline-item:nth-child(n+5) {
    display: none !important;
  }
  .jc-events-grid-layout.jc-expanded .jc-timeline .jc-timeline-item {
    display: flex !important;
  }
  #jc-load-more-btn {
    display: block !important;
    margin: 16px auto 0 !important;
  }
}


/* ==========================================================================
   5. SONDAGE FORMINATOR
   ========================================================================== */
.forminator-poll {
  background: #ffffff !important;
  border-radius: 16px !important;
  padding: 26px !important;
  box-shadow: 0 4px 20px rgba(0,0,0,0.06) !important;
  border: 1px solid #eaeaea !important;
}
.forminator-poll .forminator-poll-title {
  font-size: 1.15rem !important;
  font-weight: 700 !important;
  color: #111827 !important;
  margin-bottom: 20px !important;
  line-height: 1.4 !important;
}
.forminator-poll .forminator-radio {
  background: #f9fafb !important;
  border: 1px solid #f3f4f6 !important;
  border-radius: 10px !important;
  padding: 12px 14px !important;
  margin-bottom: 10px !important;
}
.forminator-poll .forminator-radio:hover {
  background: #f3f4f6 !important;
  border-color: #e5e7eb !important;
}
.forminator-poll .forminator-button-submit {
  width: 100% !important;
  background: #2d5a3d !important;
  color: #ffffff !important;
  border: none !important;
  border-radius: 8px !important;
  padding: 14px !important;
  font-size: 1rem !important;
  font-weight: 600 !important;
  margin-top: 8px !important;
  cursor: pointer !important;
}
.forminator-poll .forminator-button-submit:hover {
  background: #1e3d2a !important;
}

.forminator-poll .forminator-response-message {
  background-color: #e8f4ec !important;
  border: 1px solid #a8d4b4 !important;
  border-left: 4px solid #2d5a3d !important;
  border-radius: 10px !important;
  padding: 12px 16px !important;
}
.forminator-poll .forminator-label--forminator-error {
  font-size: 0 !important;
  color: transparent !important;
  display: block !important;
}
.forminator-poll .forminator-label--forminator-error::before {
  content: "Vous avez déjà enregistré votre vote. Merci !" !important;
  font-size: 0.95rem !important;
  color: #2d5a3d !important;
  font-weight: 500 !important;
  display: block !important;
}


/* ==========================================================================
   6. ÉLÉMENTS MASQUÉS
   ========================================================================== */
.header-widget-1, .header-widget-2 { display: none !important; }
.forminator-field-postdata,
.forminator-field-postdata .forminator-button-submit { display: none !important; }
.forminator-poll-edit-link,
.edit-link,
a[href*="action=edit"] { display: none !important; }
#menu-item-1885 { display: none !important; }

@media all and (display-mode: standalone) {
  .hdsb-stickybanner { display: none !important; }
}

.home .page-hero h1,
.home .entry-header h1,
.home .generate-page-header h1 { font-size: 1.8rem !important; }


/* ==========================================================================
   7. GRILLE D'ÉVÉNEMENTS (page principale — aperçu 8 événements)
   ========================================================================== */

.jc-events-grid-layout .jc-timeline {
  display: grid !important;
  grid-template-columns: 1fr !important;
  gap: 24px !important;
  list-style: none !important;
  padding: 0 !important;
  margin: 0 0 40px 0 !important;
}

@media (min-width: 640px) {
  .jc-events-grid-layout .jc-timeline {
    grid-template-columns: repeat(2, 1fr) !important;
  }
}

@media (min-width: 1024px) {
  .jc-events-grid-layout .jc-timeline {
    grid-template-columns: repeat(4, 1fr) !important;
  }
}

.jc-events-grid-layout .jc-timeline-item {
  background-color: #fcfbf7 !important;
  border: 1px solid #e2ded2 !important;
  border-radius: 12px !important;
  padding: 20px !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: space-between !important;
  position: relative !important;
  box-shadow: 0 4px 6px rgba(0,0,0,0.04) !important;
}

.jc-events-grid-layout .jc-timeline-dot { display: none !important; }

.jc-events-grid-layout .jc-timeline-time {
  display: block !important;
  font-size: 0.85rem !important;
  font-weight: 700 !important;
  color: #c8963e !important;
  text-transform: uppercase !important;
  margin-bottom: 8px !important;
}

.jc-events-grid-layout .jc-timeline-title {
  font-size: 1.2rem !important;
  color: #1e3d2a !important;
  margin: 0 0 12px 0 !important;
  font-weight: 700 !important;
  line-height: 1.3 !important;
}

.jc-events-grid-layout .jc-timeline-img {
  width: 100% !important;
  height: 160px !important;
  object-fit: cover !important;
  border-radius: 6px !important;
  margin-bottom: 12px !important;
}

/* --- Voir plus / Voir moins (partagé grille + calendrier) -------------- */

.jc-toggle-input {
  position: absolute !important;
  opacity: 0 !important;
  pointer-events: none !important;
}

/* Description : 2 lignes par défaut, complète quand étendu */
.jc-timeline-desc {
  display: -webkit-box !important;
  -webkit-line-clamp: 2 !important;
  -webkit-box-orient: vertical !important;
  overflow: hidden !important;
  margin: 4px 0 8px 0 !important;
  font-size: 0.9rem !important;
  color: #333 !important;
}
.jc-toggle-input:checked ~ .jc-timeline-desc {
  -webkit-line-clamp: unset !important;
  overflow: visible !important;
}

/* Méta courte : coût + adresse (vue réduite) */
.jc-meta-court {
  font-size: 0.85rem !important;
  color: #2d5a3d !important;
  margin-bottom: 8px !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
}
.jc-toggle-input:checked ~ .jc-meta-court { display: none !important; }

/* Méta complète : cachée par défaut, visible quand étendu */
.jc-meta-complet { display: none !important; }
.jc-toggle-input:checked ~ .jc-meta-complet {
  display: block !important;
  font-size: 0.85rem !important;
  color: #2d5a3d !important;
  line-height: 1.6 !important;
  margin-bottom: 8px !important;
}

/* Label Voir plus / Voir moins */
.jc-toggle-label {
  display: inline-block !important;
  cursor: pointer !important;
  color: #2d5a3d !important;
  font-weight: 600 !important;
  font-size: 0.85rem !important;
  margin-top: 4px !important;
}
.jc-toggle-label::before { content: "Voir plus \2192"; }
.jc-toggle-input:checked ~ .jc-toggle-label::before { content: "Voir moins \2191"; }

/* Focus clavier */
.jc-toggle-label:focus-visible {
  outline: 2px solid #2d5a3d !important;
  outline-offset: 2px !important;
}

/* --- Forum + sondage côte à côte ---------------------------------------- */

.jc-native-footer-row {
  display: flex !important;
  flex-direction: column !important;
  gap: 32px !important;
  margin-top: 50px !important;
  border-top: 1px solid #e2ded2 !important;
  padding-top: 40px !important;
}

@media (min-width: 1024px) {
  .jc-native-footer-row {
    flex-direction: row !important;
    align-items: flex-start !important;
  }
  .jc-native-forum-col {
    flex: 1 1 62% !important;
    min-width: 0 !important;
  }
  .jc-native-poll-col {
    flex: 1 1 34% !important;
    min-width: 0 !important;
    background-color: #ffffff !important;
    padding: 24px !important;
    border: 1px solid #e2ded2 !important;
    border-radius: 12px !important;
    box-shadow: 0 4px 6px rgba(0,0,0,0.06) !important;
  }
}


/* ==========================================================================
   7B. CALENDRIER COMPLET — liste de tous les événements par mois
   ========================================================================== */

.jc-calendrier-complet {
  max-width: 860px !important;
  margin: 0 auto !important;
  padding: 0 16px !important;
}

/* Lien retour */
.jc-cal-header { margin-bottom: 28px !important; }
.jc-retour-btn {
  color: #2d5a3d !important;
  text-decoration: none !important;
  font-weight: 600 !important;
  font-size: 0.9rem !important;
}
.jc-retour-btn:hover { text-decoration: underline !important; color: #1e3d2a !important; }

/* En-tête de mois */
.jc-cal-mois-groupe { margin-bottom: 36px !important; }
.jc-cal-mois-titre {
  font-size: 1.2rem !important;
  font-weight: 800 !important;
  color: #2d5a3d !important;
  border-bottom: 2px solid #c8dfc8 !important;
  padding-bottom: 8px !important;
  margin: 0 0 16px 0 !important;
  text-transform: capitalize !important;
}

/* Ligne d'événement */
.jc-cal-evenement {
  display: flex !important;
  align-items: flex-start !important;
  gap: 16px !important;
  padding: 14px 0 !important;
  border-bottom: 1px solid #e2ded2 !important;
}
.jc-cal-evenement:last-child { border-bottom: none !important; }

/* Miniature */
.jc-cal-img {
  width: 80px !important;
  height: 80px !important;
  object-fit: cover !important;
  border-radius: 8px !important;
  flex-shrink: 0 !important;
}

/* Contenu */
.jc-cal-contenu { flex: 1 !important; min-width: 0 !important; }

.jc-cal-date {
  font-size: 0.8rem !important;
  font-weight: 700 !important;
  color: #c8963e !important;
  text-transform: uppercase !important;
  margin-bottom: 3px !important;
}

.jc-cal-titre {
  font-size: 1.05rem !important;
  font-weight: 700 !important;
  color: #1e3d2a !important;
  margin: 0 0 4px 0 !important;
  line-height: 1.3 !important;
}

/* Message si aucun événement */
.jc-cal-vide {
  color: #2d5a3d !important;
  font-style: italic !important;
  text-align: center !important;
  padding: 40px 0 !important;
}

/* Mobile */
@media (max-width: 600px) {
  .jc-cal-evenement { flex-wrap: wrap !important; }
  .jc-cal-img { width: 56px !important; height: 56px !important; }
}


/* ==========================================================================
   8. RÈGLES MOBILES (≤ 768 px)
   ========================================================================== */
@media (max-width: 768px) {
  .main-navigation { display: none !important; }

  .inside-header {
    flex-direction: column !important;
    justify-content: center !important;
    padding: 16px !important;
  }
  .site-branding-container {
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
  }
  img.header-image.is-logo-image {
    margin-right: 0 !important;
    margin-bottom: 10px !important;
  }
  .site-branding { align-items: center !important; }
  p.site-description { text-align: center !important; }

  .forminator-poll .forminator-radio.forminator-disabled,
  .forminator-poll .forminator-poll-body,
  .forminator-poll .forminator-poll-footer {
    display: none !important;
  }
}